---
const { title = 'Notes from Kedar', description = 'Writing on software, systems, and the things I learn along the way.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root { font-family: 'DM Sans', sans-serif; color: #242923; background: #f7f5ef; font-synthesis: none; text-rendering: optimizeLegibility; }
      * { box-sizing: border-box; }
      body { margin: 0; min-width: 320px; }
      a { color: inherit; }
      .shell { width: min(1080px, calc(100% - 48px)); margin: auto; }
      .topbar { height: 82px; border-bottom: 1px solid #e5e2d8; display: flex; align-items: center; justify-content: space-between; }
      .brand { font-family: 'Playfair Display', serif; font-size: 21px; font-weight: 700; text-decoration: none; letter-spacing: -.4px; }
      .brand span { color: #b65e3d; }
      .nav { display: flex; align-items: center; gap: 30px; font-size: 13px; color: #666a61; }
      .nav a { text-decoration: none; }
      .nav a:hover { color: #b65e3d; }
      .intro { padding: 86px 0 68px; border-bottom: 1px solid #e5e2d8; display: grid; grid-template-columns: 1fr 250px; align-items: end; gap: 48px; }
      .eyebrow, .meta, .label { font-family: 'DM Mono', monospace; text-transform: uppercase; letter-spacing: 1.1px; font-size: 10px; color: #9a7058; }
      h1 { font-family: 'Playfair Display', serif; font-size: clamp(46px, 6vw, 72px); line-height: 1.04; letter-spacing: -2px; font-weight: 500; margin: 18px 0 20px; max-width: 700px; }
      .intro-copy { color: #75786f; line-height: 1.75; max-width: 550px; font-size: 15px; margin: 0; }
      .intro-note { border-left: 1px solid #d8d3c7; padding: 4px 0 4px 20px; color: #77796f; font-size: 12px; line-height: 1.8; }
      .intro-note strong { display: block; color: #33382f; font-size: 13px; margin-bottom: 5px; }
      .content { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 90px; padding: 57px 0 90px; }
      .section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
      h2 { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 24px; margin: 0; }
      .count { color: #8b8c82; font: 10px 'DM Mono', monospace; }
      .post { padding: 24px 0; border-top: 1px solid #e5e2d8; display: grid; grid-template-columns: 1fr auto; gap: 16px; }
      .post h3 { font: 600 20px 'Playfair Display', serif; margin: 8px 0; }
      .post h3 a { text-decoration: none; }
      .post h3 a:hover { color: #b65e3d; }
      .post p { color: #77796f; font-size: 13px; line-height: 1.7; margin: 0; max-width: 620px; }
      .post-date { color: #929187; font: 10px 'DM Mono', monospace; white-space: nowrap; padding-top: 3px; }
      .tag { display: inline-block; margin-top: 12px; color: #8f634e; border: 1px solid #e2d6c8; padding: 4px 8px; border-radius: 2px; font: 9px 'DM Mono', monospace; }
      aside { padding-top: 2px; }
      .side-card { border-top: 1px solid #d9d4c8; padding: 19px 0 25px; }
      .side-card p { color: #77796f; font-size: 12px; line-height: 1.8; margin: 11px 0 0; }
      .side-link { display: inline-block; color: #b65e3d; font-size: 12px; text-decoration-thickness: 1px; text-underline-offset: 3px; margin-top: 12px; }
      .save-button { margin-top: 16px; border: 1px solid #d9d4c8; border-radius: 3px; padding: 10px 12px; width: 100%; background: transparent; color: #64675f; cursor: pointer; text-align: left; font: 11px 'DM Sans', sans-serif; }
      .save-button span { color: #b65e3d; margin-right: 8px; font-size: 14px; }
      footer { border-top: 1px solid #e5e2d8; padding: 24px 0 36px; color: #8b8c82; display: flex; justify-content: space-between; font-size: 11px; }
      @media (max-width: 720px) { .shell { width: min(100% - 36px, 560px); } .topbar { height: 70px; } .nav { gap: 17px; } .intro { padding: 63px 0 48px; grid-template-columns: 1fr; gap: 27px; } .intro-note { max-width: 360px; } .content { grid-template-columns: 1fr; gap: 32px; padding-top: 40px; } aside { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; } }
      @media (max-width: 440px) { .nav { gap: 12px; font-size: 11px; } .post { grid-template-columns: 1fr; gap: 8px; } .post-date { grid-row: 1; } aside { grid-template-columns: 1fr; gap: 0; } }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href="/">kedar<span>.</span>notes</a>
        <nav class="nav" aria-label="Main navigation">
          <a href="/">Writing</a>
          <a href="#about">About</a>
          <a href="https://github.com/KedarDamale">GitHub ↗</a>
        </nav>
      </header>
      <slot />
      <footer><span>© {new Date().getFullYear()} Kedar Damale</span><span>Made for curious minds.</span></footer>
    </div>
  </body>
</html>
